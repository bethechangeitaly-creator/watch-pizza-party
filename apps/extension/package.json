{
    "name": "@watch-party/extension",
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build -c vite.config.mjs && SCRIPT_ENTRY=content vite build -c vite.scripts.config.mjs && SCRIPT_ENTRY=player-bridge vite build -c vite.scripts.config.mjs && node scripts/check-dist.mjs",
        "test": "vitest run"
    },
    "dependencies": {
        "@watch-party/shared": "*",
        "clsx": "^2.1.0",
        "lucide-react": "^0.344.0",
        "nanoid": "^5.0.6",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "socket.io-client": "^4.7.4",
        "tailwind-merge": "^2.2.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/chrome": "^0.0.260",
        "@types/react": "^18.2.55",
        "@types/react-dom": "^18.2.19",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "jsdom": "^25.0.1",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "vite": "^5.1.4",
        "vite-plugin-static-copy": "^1.0.1",
        "vitest": "^3.2.4"
    }
}
