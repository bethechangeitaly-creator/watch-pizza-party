{
    "manifest_version": 3,
    "name": "Watch Pizza Party",
    "version": "2.0.0",
    "description": "Synchronized watch parties for Netflix, YouTube and Prime Video with real-time chat.",
    "incognito": "split",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Watch Pizza Party",
        "default_icon": {
            "16": "icon16.png",
            "32": "icon32.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "sidePanel",
        "storage",
        "activeTab",
        "scripting",
        "tabs",
        "tabCapture",
        "offscreen"
    ],
    "host_permissions": [
        "https://*.netflix.com/*",
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://watch-pizza-party.onrender.com/*"
    ],
    "optional_host_permissions": [
        "https://*.primevideo.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.de/*",
        "https://*.amazon.it/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.es/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.co.jp/*",
        "https://*.amazon.com.au/*",
        "https://*.amazon.in/*",
        "https://*.amazon.com.br/*",
        "https://*.amazon.com.mx/*",
        "https://*.amazon.nl/*",
        "https://*.amazon.se/*",
        "https://*.amazon.pl/*",
        "https://*.amazon.com.be/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://*.youtube.com/*",
                "https://youtu.be/*",
                "https://*.netflix.com/*"
            ],
            "js": [
                "player-bridge.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://*.youtube.com/*",
                "https://youtu.be/*",
                "https://*.netflix.com/*"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": false
        }
    ],
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icon32.png"
            ],
            "matches": [
                "https://*.youtube.com/*",
                "https://*.netflix.com/*"
            ]
        }
    ]
}
