PORT=3005
# Giphy API key for the /gifs proxy. Leave empty to disable GIF search.
GIPHY_API_KEY=
# Extra exact origins allowed by CORS (comma separated), on top of chrome-extension:// and localhost.
ALLOWED_ORIGINS=
# Set to 1 only when a reverse proxy (Render, Fly, nginx…) is in front and appends X-Forwarded-For.
TRUST_PROXY=
